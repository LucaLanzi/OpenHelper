[Unit]
Description=OpenHelper engine and dashboard
After=openhelper-llm.service
Wants=openhelper-llm.service

[Service]
# systemd user services start with a minimal PATH; use the one from install time.
Environment=PATH=@PATH@
Environment=OPENHELPER_ROOT=@ROOT@
Environment=OPENHELPER_WORKSPACE=@WS@
WorkingDirectory=@ROOT@
ExecStart=@NODE@ @ROOT@/server/dist/cli.js serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=default.target
